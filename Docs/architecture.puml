@startuml Architecture_ByteCollector
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

package "ByteCollector.Gameplay" {
    class PlayerController {
        - moveSpeed: float
        - topPadding: float
        - bottomPadding: float
        - sidePadding: float
        - rb: Rigidbody2D
        - movementInput: Vector2
        - mainCamera: Camera
        - horizontalLimits: Vector2
        - verticalLimits: Vector2
        + UpdateCameraBounds(): void
        + SetSpeed(newSpeed: float): void
        + GetSpeed(): float
        + GetHorizontalLimits(): Vector2
        + GetVerticalLimits(): Vector2
    }

    class PlayerHealth {
        - maxLives: int
        - currentLives: int
        - invulnerabilityDuration: float
        - blinkInterval: float
        - isInvulnerable: bool
        - isDead: bool
        - spriteRenderer: SpriteRenderer
        - playerController: PlayerController
        - popupChannel: PopupEventSO
        + CurrentLives: int
        + IsDead: bool
        + TakeDamage(damage: int): void
        - OnTriggerStay2D(collision: Collider2D): void
        - OnCollisionStay2D(collision: Collision2D): void
        - CheckHazardCollision(other: GameObject): void
        - InvulnerabilityRoutine(): IEnumerator
        - TriggerGameOver(): void
    }

    class DataBit {
        - spawner: BitSpawner
        + Initialize(spawnerReference: BitSpawner): void
        - OnTriggerEnter2D(collision: Collider2D): void
        - Collect(): void
    }

    class BitSpawner {
        - hudController: HUDController
        - dataBitPrefab: GameObject
        - totalCollected: int
        - currentBit: GameObject
        - mainCamera: Camera
        + SpawnNextBit(): void
        + OnBitCollected(): void
        + GetTotalCollected(): int
        - GetSafeSpawnPosition(): Vector2
    }

    class GameLoopManager <<Singleton>> {
        + {static} Instance: GameLoopManager
        + {static} MemoryFlushed: event Action
        - playerController: PlayerController
        - hudController: HUDController
        - mainCamera: Camera
        - txtSectorNotification: TextMeshProUGUI
        - imgScreenFlash: Image
        - glitchSpawner: GlitchSpawner
        - sector1Target: int
        - sector2Target: int
        - sector1BgColor: Color
        - sector2BgColor: Color
        - currentSector: int
        - currentBits: int
        - totalScore: int
        + RegisterBitCollected(): void
        - TriggerMemoryFlushRoutine(): IEnumerator
        - FlashScreenRoutine(): IEnumerator
        - ShowSectorNotification(message: string): IEnumerator
    }

    class GlitchSpawner {
        - player: Transform
        - leakPrefab: GlitchEnemy
        - corruptedTilePrefab: GameObject
        - sector1LeakInterval: float
        - sector1MaxLeaks: int
        - sector2LeakInterval: float
        - sector2MaxLeaks: int
        - tileInterval: float
        - minSpawnDistanceFromPlayer: float
        - topUiReserve: float
        - bottomUiReserve: float
        - cam: Camera
        + SetSector(sector: int): void
        - LeakLoop(interval: float, maxLeaks: int): IEnumerator
        - TileLoop(): IEnumerator
        - GetSpawnPosition(): Vector2
    }

    class GlitchEnemy {
        + {static} ActiveCount: int
        - speed: float
        - target: Transform
        - rb: Rigidbody2D
        + Initialize(playerTransform: Transform): void
        - HandleMemoryFlush(): void
    }

    class CorruptedTile {
        - warningTime: float
        - activeTime: float
        - Lifecycle(): IEnumerator
    }
}

package "ByteCollector.UI" {
    class HUDController {
        - healthIcons: Image[]
        - healthActiveColor: Color
        - healthInactiveColor: Color
        - bitProgressText: TextMeshProUGUI
        - bitProgressBar: Slider
        - scoreText: TextMeshProUGUI
        + UpdateHealth(currentLives: int): void
        + UpdateBitProgress(currentBits: int, targetBits: int): void
        + UpdateScore(newScore: int): void
    }

    class GameOverUI {
        + RestartGame(): void
        + GoToMainMenu(): void
    }

    class UIManager {
        - panelMain: GameObject
        - panelOptions: GameObject
        - panelCredits: GameObject
        - gameplaySceneName: string
        - creditsSceneName: string
        + PlayGame(): void
        + OpenCreditsScene(): void
        + QuitGame(): void
        + ShowMainMenu(): void
        + ShowOptions(): void
        + ShowCredits(): void
    }

    class PopupManager {
        - popupChannel: PopupEventSO
        - popupViewInstance: GenericPopupView
        - OnEnable(): void
        - OnDisable(): void
        - ShowPopup(data: PopupData): void
        - HandlePopupClosed(): void
    }

    class GenericPopupView {
        - txtTitle: TextMeshProUGUI
        - txtMessage: TextMeshProUGUI
        - btnConfirm: Button
        - btnCancel: Button
        - confirmCommand: ICommand
        - cancelCommand: ICommand
        + OnPopupClosed: event Action
        + Configure(data: PopupData): void
        - HandleConfirmClicked(): void
        - HandleCancelClicked(): void
        + Close(): void
    }
}

package "ByteCollector.Events" {
    class PopupEventSO <<ScriptableObject>> {
        + OnPopupRequested: event Action<PopupData>
        + Raise(data: PopupData): void
    }

    class PopupData {
        + Title: string
        + Message: string
        + ConfirmCommand: ICommand
        + CancelCommand: ICommand
        + PopupData(title, message, confirmCommand, cancelCommand)
    }
}

package "ByteCollector.Commands" {
    interface ICommand {
        + Execute(): void
    }

    class RestartLevelCommand {
        + Execute(): void
    }

    class ReturnToMenuCommand {
        - {static} MAIN_MENU_SCENE: string
        + Execute(): void
    }
}

package "Entities tagged as Hazard / Glitch" {
    class ObstacleEntity <<Tag: Hazard / Glitch>> {
        + Collider2D (trigger)
        + Collision or trigger response
    }
}

' Relaciones de gameplay
PlayerHealth --> PlayerController : desactiva movimiento y frena
PlayerHealth --> HUDController : actualiza vidas
PlayerHealth ..> ObstacleEntity : detecta Hazard / Glitch

DataBit --> BitSpawner : notifica recolección
BitSpawner ..> DataBit : instancia prefabricados
BitSpawner --> GameLoopManager : avisa recolección de bits
BitSpawner --> HUDController : actualiza progreso si no hay GameLoop

GameLoopManager --> PlayerController : aumenta velocidad al pasar de sector
GameLoopManager --> HUDController : actualiza score y progreso
GameLoopManager --> Camera : cambia color de fondo
GameLoopManager --> GlitchSpawner : SetSector(1) al iniciar / SetSector(2) tras el Memory Flush

' Relaciones de enemigos y obstaculos
GlitchSpawner ..> GlitchEnemy : instancia Glitch_Leak (Sector 1 y 2)
GlitchSpawner ..> CorruptedTile : instancia baldosas (Sector 2)
GlitchSpawner --> PlayerController : usa el Transform del jugador y mantiene distancia minima
GlitchEnemy ..> GameLoopManager : se suscribe a MemoryFlushed y se destruye
GlitchEnemy --> PlayerController : persigue con Vector2.MoveTowards
GlitchEnemy ..|> ObstacleEntity : tag Hazard
CorruptedTile ..|> ObstacleEntity : tag Hazard (fase activa)

' Relaciones de navegación UI
UIManager --> GameOverUI : navegación de menú y escenas

' Servicio de pop-up reutilizable: Observer (evento) + Command (acciones)
PlayerHealth --> PopupEventSO : Raise(PopupData) al quedar sin vidas (emisor)
PlayerHealth ..> PopupData : crea con título y mensaje
PlayerHealth ..> RestartLevelCommand : crea (confirmar)
PlayerHealth ..> ReturnToMenuCommand : crea (cancelar)
PopupManager ..> PopupEventSO : se suscribe a OnPopupRequested (receptor)
PopupEventSO ..> PopupData : transporta
PopupData o-- ICommand : ConfirmCommand / CancelCommand
RestartLevelCommand ..|> ICommand
ReturnToMenuCommand ..|> ICommand
PopupManager --> GenericPopupView : Configure(data) y activa el pop-up
GenericPopupView ..> PopupManager : evento OnPopupClosed
GenericPopupView --> ICommand : Execute() al pulsar un botón
@enduml